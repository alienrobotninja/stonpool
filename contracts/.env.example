# Blueprint deploy/run config for the contracts package.
# This file is gitignored (.gitignore: .env, .env.*). Do NOT commit it filled.
# Copy from .env.example, fill, keep secret.

# --- Deployer wallet ---------------------------------------------------------
# Blueprint's Mnemonic signer reads these EXACT names. The mnemonic must control
# a funded testnet wallet, and WALLET_VERSION must match that wallet's contract
# version, or blueprint derives a different (unfunded) address.
#   Tonkeeper "W5" (current default) -> v5r1
#   Tonkeeper older / v4R2           -> v4
WALLET_MNEMONIC=
WALLET_VERSION=v5r1

# --- Network -----------------------------------------------------------------
# Network is chosen by the CLI flag, not env:
#   npx blueprint run deployMockStack --testnet
#   npx blueprint run deployMockStack --mainnet
#
# To override the default public RPC (e.g. a toncenter API key to dodge rate
# limits), either pass flags:
#   --custom https://testnet.toncenter.com/api/v2/jsonRPC --custom-key <KEY> --custom-type testnet
# or set network.endpoint / network.key in blueprint.config.ts.
# Left here for reference; blueprint does not auto-read these:
# TONCENTER_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
# TONCENTER_API_KEY=

# --- Deploy parameters -------------------------------------------------------
# The faucet funding and drip/cooldown values are compile-time constants in
# wrappers/mockStack.ts (FAUCET_FUNDING, DRIP, MINT_VALUE, COOLDOWN), not env.
# Lower FAUCET_FUNDING there if testnet TON is scarce.
