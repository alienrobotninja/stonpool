STONPOOL_ENV=testnet
STONPOOL_DATABASE_URL=postgresql+asyncpg://stonpool:stonpool@localhost:5432/stonpool
STONPOOL_TONCENTER_BASE_URL=https://testnet.toncenter.com/api/v3
STONPOOL_TONCENTER_API_KEY=

# deployed addresses (raw 0:hex), from `blueprint run deployStonpool` + deployMockStack
STONPOOL_JETTON_MASTER_ADDRESS=
STONPOOL_POOL_CORE_ADDRESS=
STONPOOL_ADAPTER_ADDRESS=
STONPOOL_DRAW_ENGINE_ADDRESS=
STONPOOL_VAULT_ADDRESS=
STONPOOL_STONFI_POOL_ADDRESS=
STONPOOL_STONFI_ROUTER_ADDRESS=
STONPOOL_GOVERNOR_ADDRESS=

# keeper: must match the on-chain config the pool deployed with
STONPOOL_DEPOSIT_CUTOFF=600
STONPOOL_SKIM_BPS=1000
STONPOOL_PRIZE_TIERS=3

# keeper runtime: leave the mnemonic empty to dry-run (no broadcast)
STONPOOL_OPERATOR_MNEMONIC=
STONPOOL_KEEPER_POLL_INTERVAL=15
STONPOOL_KEEPER_DRY_RUN=false
STONPOOL_KEEPER_MIN_YIELD=1
