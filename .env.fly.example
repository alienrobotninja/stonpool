# Source for fly-secrets.sh / fly-secrets.ps1. Copy to .env.fly (gitignored), fill, then
# run the script. Every key here must exist in backend Settings or it is silently ignored.

STONPOOL_ENV=testnet

# Neon, not Fly Postgres: paste the pooler DSN from the Neon console. db_pooled must be
# true for a -pooler host or asyncpg reuses prepared statements the pooler has discarded.
STONPOOL_DATABASE_URL=
STONPOOL_DB_POOLED=true

STONPOOL_TONCENTER_BASE_URL=https://testnet.toncenter.com/api/v3
STONPOOL_TONCENTER_API_KEY=
# a derive pass fires one get-method per depositor plus five pool reads, back to back;
# without a floor between calls the burst outruns the key's cap partway through
STONPOOL_TONCENTER_MIN_INTERVAL=0.12
STONPOOL_TONCENTER_MAX_RETRIES=4

STONPOOL_JETTON_MASTER_ADDRESS=
STONPOOL_POOL_CORE_ADDRESS=
STONPOOL_ADAPTER_ADDRESS=
STONPOOL_DRAW_ENGINE_ADDRESS=
STONPOOL_VAULT_ADDRESS=
STONPOOL_STONFI_POOL_ADDRESS=
STONPOOL_STONFI_ROUTER_ADDRESS=
STONPOOL_GOVERNOR_ADDRESS=

STONPOOL_DEPOSIT_CUTOFF=120
STONPOOL_SKIM_BPS=1000
STONPOOL_PRIZE_TIERS=3
STONPOOL_MIN_HOLD_EPOCHS=1

STONPOOL_INDEXER_POLL_INTERVAL=10
STONPOOL_DERIVE_POLL_INTERVAL=60

# empty -> keeper dry-runs (no broadcast)
STONPOOL_OPERATOR_MNEMONIC=
STONPOOL_KEEPER_POLL_INTERVAL=15
STONPOOL_KEEPER_DRY_RUN=false
STONPOOL_KEEPER_MIN_YIELD=1