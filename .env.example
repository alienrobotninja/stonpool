# Copy to .env and fill. Do not commit the filled file.

# --- Network ---
TON_NETWORK=testnet
TONCENTER_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
TONCENTER_API_KEY=

# --- Deploy / ops (T1) ---
# Deployer wallet mnemonic. Keep out of version control.
DEPLOYER_MNEMONIC=

# --- Scheduler (B3) ---
# Operator wallet that pokes permissionless entrypoints and posts the draw bond.
OPERATOR_MNEMONIC=
EPOCH_POLL_INTERVAL_SECONDS=15

# --- STON.fi (B1, C6) ---
# api.ston.fi serves mainnet only.
STONFI_API_BASE=https://api.ston.fi
# Referrer address that accrues STON.fi DEX v2 referral fee vaults.
STONFI_REFERRER_ADDRESS=

# --- Backend (B0, B4) ---
DATABASE_URL=postgresql+psycopg://stonpool:stonpool@localhost:5432/stonpool
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# --- Frontend (F1, F3) ---
VITE_API_BASE=http://localhost:8000
VITE_TON_NETWORK=testnet
VITE_TONCONNECT_MANIFEST_URL=
